# Pi-hole environment configuration (example for manual setup)

# FTLconf Web-server API password
WEBPASSWORD=super-secret-password

# Absolute host path for Docker bind volume (ZFS mountpoint)
PIHOLE_DATA_VOLUME=/tank/docker/data/Pihole

# Pi Hole IP Bind Eg. Set to Host Tailscale IP or leave as is.
PIHOLE_IP_BIND=0.0.0.0